<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.softwareengineerticketproject.WorkerRegisterPageController">
    <children>
        <Label text="Register" textAlignment="CENTER">
            <font>
                <Font size="22.0" />
            </font></Label>
        <Label text="WORKER" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="12.0" />
            </font></Label>
        <TextField fx:id="usernameTextfield" alignment="CENTER" promptText="Username" />
      <PasswordField fx:id="passwordPasswordfield" alignment="CENTER" promptText="Password" />
        <TextField fx:id="firstNameTextfield" alignment="CENTER" promptText="First Name" />
        <TextField fx:id="lastNameTextfield" alignment="CENTER" promptText="Last name" />
        <TextField fx:id="emailTextfield" alignment="CENTER" promptText="Email" />
      <PasswordField fx:id="pinPasswordfield" alignment="CENTER" promptText="PIN" />
        <HBox alignment="TOP_CENTER" prefHeight="35.0" prefWidth="600.0" spacing="50.0">
            <children>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancelButtonClicked" text="Cancel" textAlignment="CENTER" />
                <Button fx:id="registerButton" mnemonicParsing="false" onAction="#registerButtonClicked" text="Register" textAlignment="CENTER" />
            </children>
        </HBox>
        <Label fx:id="errorLabel" textAlignment="CENTER" textFill="RED" wrapText="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
    </children>
</VBox>
