<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.softwareengineerticketproject.WorkerHomePageController">
    <children>
        <TabPane layoutY="88.0" prefHeight="362.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Tickets">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <HBox layoutY="8.0" prefHeight="325.0" prefWidth="600.0">
                                    <children>
                                        <VBox fx:id="VBox1" prefHeight="325.0" prefWidth="166.0">
                                            <children>
                                                <Label prefHeight="59.0" prefWidth="166.0" text="Label" />
                                            </children>
                                        </VBox>
                              <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <TableView prefHeight="200.0" prefWidth="200.0">
                                      <columns>
                                        <TableColumn prefWidth="75.0" text="ID" />
                                        <TableColumn prefWidth="75.0" text="Device Info" />
                                          <TableColumn prefWidth="75.0" text="Issue Type" />
                                          <TableColumn prefWidth="75.0" text="Completion" />
                                          <TableColumn prefWidth="75.0" text="Desc Issue" />
                                          <TableColumn prefWidth="75.0" text="User ID" />
                                      </columns>
                                    </TableView>
                                 </children>
                              </VBox>
                                    </children>
                                </HBox>
                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab text="Updates">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <Label layoutX="549.0" layoutY="14.0" text="worker" />
      <Label layoutX="14.0" layoutY="14.0" text="Welcome: " />
      <Label fx:id="usernameLabel" layoutX="70.0" layoutY="14.0">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="logoutButton" layoutX="542.0" layoutY="31.0" mnemonicParsing="false" onAction="#logoutButtonClicked" text="Logout" />
    </children>
</AnchorPane>
