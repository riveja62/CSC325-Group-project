<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.softwareengineerticketproject.WorkerHomePageController">
    <children>
        <TabPane layoutY="70.0" prefHeight="380.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Tickets">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <HBox layoutY="8.0" prefHeight="345.0" prefWidth="600.0">
                                    <children>
                                        <VBox fx:id="VBox1" prefHeight="325.0" prefWidth="166.0">
                                 <children>
                                    <Label text="Subject" underline="true" />
                                    <Label fx:id="subjectLabel" wrapText="true" />
                                    <HBox prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                             <children>
                                                <Label text="User:" />
                                                <Label text="Device:" />
                                                <Label text="Issue:" />
                                             </children>
                                          </VBox>
                                          <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                             <children>
                                                <Label fx:id="userLabel" wrapText="true" />
                                                <Label fx:id="deviceLabel" wrapText="true" />
                                                <Label fx:id="issueLabel" wrapText="true" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Label text="Description" underline="true" />
                                    <TextArea fx:id="descriptionTextArea" editable="false" prefHeight="162.0" prefWidth="166.0" wrapText="true" />
                                    <CheckBox fx:id="completionCheckBox" mnemonicParsing="false" onAction="#completionToggled" text="Completed" />
                                 </children>
                                        </VBox>
                              <VBox prefHeight="354.0" prefWidth="434.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <TableView fx:id="ticketsTableView" prefHeight="340.0" prefWidth="434.0" VBox.vgrow="ALWAYS">
                                      <columns>
                                          <TableColumn fx:id="subjectColumn" prefWidth="75.0" text="Subject" />
                                          <TableColumn fx:id="issueColumn" prefWidth="75.0" text="Issue" />
                                        <TableColumn fx:id="deviceColumn" prefWidth="75.0" text="Device" />
                                          <TableColumn fx:id="completionColumn" prefWidth="75.0" text="Completion" />
                                          <TableColumn fx:id="userColumn" prefWidth="75.0" text="User ID" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                                    </children>
                                </HBox>
                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab text="Updates">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <Label layoutX="549.0" layoutY="14.0" text="worker" />
      <Label layoutX="14.0" layoutY="14.0" text="Welcome: " />
      <Label fx:id="usernameLabel" layoutX="70.0" layoutY="14.0">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="logoutButton" layoutX="542.0" layoutY="31.0" mnemonicParsing="false" onAction="#logoutButtonClicked" text="Logout" />
    </children>
</AnchorPane>
