<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.softwareengineerticketproject.ClientHomePageController">
   <children>
      <TabPane layoutY="88.0" prefHeight="362.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Create">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <HBox layoutY="8.0" prefHeight="325.0" prefWidth="600.0">
                           <children>
                              <VBox fx:id="VBox1" prefHeight="325.0" prefWidth="166.0">
                                 <children>
                                    <Label text="Past Tickets" underline="true" />
                                    <TableView fx:id="createTable" prefHeight="309.0" prefWidth="166.0">
                                      <columns>
                                        <TableColumn fx:id="createSubjectColumn" prefWidth="75.0" text="Subject" />
                                        <TableColumn fx:id="createCompletedColumn" prefWidth="75.0" text="Completed" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children></VBox>
                              <VBox prefHeight="325.0" prefWidth="434.0">
                                 <children>
                                    <Label text="Subject">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font></Label>
                                    <TextField fx:id="subjectTextField" />
                                    <HBox alignment="CENTER" prefHeight="38.0" prefWidth="434.0" spacing="30.0">
                                       <children>
                                          <Label text="Description">
                                             <font>
                                                <Font name="System Bold" size="12.0" />
                                             </font></Label>
                                          <ChoiceBox fx:id="deviceChoiceBox" prefWidth="150.0" />
                                          <ChoiceBox fx:id="issueChoiceBox" prefWidth="150.0" />
                                       </children>
                                    </HBox>
                                    <TextArea fx:id="descriptionTextArea" prefHeight="178.0" prefWidth="434.0" wrapText="true" />
                                    <Button fx:id="submitTicketButton" mnemonicParsing="false" onAction="#submitTicketButtonClicked" text="Submit Ticket" />
                                    <Label fx:id="errorLabel" textAlignment="CENTER" textFill="RED" underline="true">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children></AnchorPane>
            </content>
          </Tab>
          <Tab text="Past">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <HBox prefHeight="335.0" prefWidth="600.0">
                           <children>
                              <VBox prefHeight="335.0" prefWidth="169.0">
                                 <children>
                                    <Label text="Subject" underline="true" />
                                    <Label fx:id="subjectLabel" wrapText="true" />
                                    <HBox prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                             <children>
                                                <Label text="Completed:" />
                                                <Label text="Device" />
                                                <Label text="Issue" />
                                             </children>
                                          </VBox>
                                          <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                                             <children>
                                                <Label fx:id="completedLabel" />
                                                <Label fx:id="deviceLabel" />
                                                <Label fx:id="issueLabel" />
                                             </children></VBox>
                                       </children></HBox>
                                    <Label text="Description" underline="true" />
                                    <TextArea fx:id="pastDescriptionTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
                                 </children></VBox>
                              <VBox prefHeight="335.0" prefWidth="440.0">
                                 <children>
                                    <TableView fx:id="pastTable" prefHeight="333.0" prefWidth="435.0">
                                      <columns>
                                        <TableColumn fx:id="pastSubjectColumn" prefWidth="75.0" text="Subject" />
                                        <TableColumn fx:id="pastIssueColumn" prefWidth="75.0" text="Issue" />
                                          <TableColumn fx:id="pastDeviceColumn" prefWidth="75.0" text="Device" />
                                          <TableColumn fx:id="pastCompletedColumn" prefWidth="75.0" text="Completed" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children></VBox>
                           </children>
                        </HBox>
                     </children></AnchorPane>
            </content>
          </Tab>
            <Tab text="FAQ">
                <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Question: what does the create tab do?" underline="true" />
                        <Label alignment="TOP_LEFT" layoutX="43.0" layoutY="31.0" prefHeight="44.0" prefWidth="556.0" text="Answer: the create tab allows you to submit a ticket based off device and issue type. You then add a subject title and a description fully of what the issue is." wrapText="true" />
                        <Label layoutX="14.0" layoutY="83.0" text="Question: what does the past tab do?" underline="true" />
                        <Label alignment="TOP_LEFT" layoutX="43.0" layoutY="100.0" prefHeight="44.0" prefWidth="556.0" text="Answer: the past tab allows you to view any of your past tickets you have made." wrapText="true" />
                        <Label layoutX="14.0" layoutY="136.0" text="Question: what does the updates tab do?" underline="true" />
                        <Label alignment="TOP_LEFT" layoutX="43.0" layoutY="153.0" prefHeight="44.0" prefWidth="556.0" text="Answer: the updates tab lets you see any updates workers have made towards yours and others tickets." wrapText="true" />
                     </children></AnchorPane>
                </content>
            </Tab>
            <Tab text="Updates">
                <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <HBox prefHeight="334.0" prefWidth="600.0">
                           <children>
                              <VBox prefHeight="334.0" prefWidth="173.0">
                                 <children>
                                    <Label text="Subject" underline="true" />
                                    <Label fx:id="updatesSubjectLabel" wrapText="true" />
                                    <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                                       <children>
                                          <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
                                             <children>
                                                <Label text="Device:" />
                                                <Label text="Issue:" />
                                             </children>
                                          </VBox>
                                          <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
                                             <children>
                                                <Label fx:id="updatesDeviceLabel" />
                                                <Label fx:id="updatesIssueLabel" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Label text="Description" underline="true" />
                                    <TextArea fx:id="updatesDescriptionTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
                                 </children></VBox>
                              <VBox prefHeight="334.0" prefWidth="438.0">
                                 <children>
                                    <TableView fx:id="updatesTableView" prefHeight="331.0" prefWidth="433.0">
                                      <columns>
                                        <TableColumn fx:id="updatesSubjectColumn" prefWidth="75.0" text="Subject" />
                                        <TableColumn fx:id="updatesDeviceColumn" prefWidth="75.0" text="Device" />
                                          <TableColumn fx:id="updatesIssueColumn" prefWidth="75.0" text="Issue" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children></AnchorPane>
                </content>
            </Tab>
        </tabs>
      </TabPane>
      <Label layoutX="557.0" layoutY="14.0" text="client" />
      <Label layoutX="14.0" layoutY="14.0" text="Welcome:" />
      <Label fx:id="usernameLabel" layoutX="67.0" layoutY="14.0">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
       <Button fx:id="logoutButton" layoutX="542.0" layoutY="31.0" mnemonicParsing="false" onAction="#logoutButtonClicked" text="Logout" />
   </children>
</AnchorPane>
